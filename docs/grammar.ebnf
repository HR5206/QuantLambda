(* Syntax reference: calls, Quantity and Series<Price> are reserved and rejected by semantic checking. See language-spec.md for supported execution. *)
Program ::= StrategyDeclaration

StrategyDeclaration ::= "strategy" Identifier "{" "on" "tick" "(" Identifier ")" BlockStatement "}"

BlockStatement ::= "{" { Statement } "}"

Statement ::= VariableDeclaration 
            | AssignmentStatement 
            | IfStatement 
            | BuyStatement 
            | SellStatement 
            | ExpressionStatement

VariableDeclaration ::= "let" Identifier [ ":" Type ] "=" Expression ";"

AssignmentStatement ::= Identifier "=" Expression ";"

IfStatement ::= "if" Expression BlockStatement [ "else" BlockStatement ]

BuyStatement ::= "buy" Expression ";"

SellStatement ::= "sell" Expression ";"

ExpressionStatement ::= Expression ";"

Expression ::= LogicalOr

LogicalOr ::= LogicalAnd { "||" LogicalAnd }

LogicalAnd ::= Equality { "&&" Equality }

Equality ::= Relational { ("==" | "!=") Relational }

Relational ::= Additive { (">" | "<" | ">=" | "<=") Additive }

Additive ::= Multiplicative { ("+" | "-") Multiplicative }

Multiplicative ::= Unary { ("*" | "/") Unary }

Unary ::= ("!" | "-") Unary | Primary

Primary ::= NumberLiteral 
          | BooleanLiteral 
          | StringLiteral 
          | Identifier 
          | CallExpression 
          | "(" Expression ")"

CallExpression ::= Identifier "(" [ Expression { "," Expression } ] ")"

Type ::= "int" | "double" | "boolean" | "string" | "Price" | "Quantity" | "Series<Price>"

Identifier ::= [a-zA-Z_] [a-zA-Z0-9_]*

NumberLiteral ::= [0-9]+ [ "." [0-9]+ ]

BooleanLiteral ::= "true" | "false"

StringLiteral ::= '"' { Any character except '"' } '"'
